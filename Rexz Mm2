-- Silent Aim (Sheriff Only)
local function findMurderer()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if getRole(player) == "Murderer" then
                return player
            end
        end
    end
    return nil
end

