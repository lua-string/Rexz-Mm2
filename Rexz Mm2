-- ESP Functions
local function getRole(player)
    local character = player.Character
    if not character then return "Unknown" end
    
    local backpack = player.Backpack
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item.Name == "Knife" then return "Murderer" end
            if item.Name == "Gun" then return "Sheriff" end
        end
    end
    
    if character:FindFirstChild("Knife") then return "Murderer" end
    if character:FindFirstChild("Gun") then return "Sheriff" end
    
    return "Innocent"
end

local function createESP(player, role)
    if not player.Character then return end
    if not player.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local esp = Instance.new("BillboardGui")
    esp.Name = player.Name .. "_ESP"
    esp.Size = UDim2.new(0, 150, 0, 40)
    esp.AlwaysOnTop = true
    esp.MaxDistance = 1000
    esp.Adornee = player.Character.HumanoidRootPart
    esp.Parent = ESPFolder
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    text.BackgroundTransparency = 0.3
    text.Text = player.Name .. " [" .. role .. "]"
    text.TextColor3 = role == "Murderer" and Color3.fromRGB(255, 0, 0) or role == "Sheriff" and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 14
    text.TextStrokeTransparency = 0
    text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    text.Parent = esp
    
    -- Add outline
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Color = role == "Murderer" and Color3.fromRGB(255, 0, 0) or role == "Sheriff" and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
    UIStroke.Thickness = 2
    UIStroke.Parent = text
    
    -- Add health bar
    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.new(1, 0, 0, 5)
    healthBar.Position = UDim2.new(0, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    healthBar.BorderSizePixel = 0
    healthBar.Parent = esp
    
    local healthFill = Instance.new("Frame")
    healthFill.Size = UDim2.new(1, 0, 1, 0)
    healthFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    healthFill.BorderSizePixel = 0
    healthFill.Parent = healthBar
    
    -- Update health
    spawn(function()
        while ESPEnabled and esp.Parent do
            if player.Character and player.Character:FindFirstChild("Humanoid") then
                local health = player.Character.Humanoid.Health
                local maxHealth = player.Character.Humanoid.MaxHealth
                healthFill.Size = UDim2.new(health / maxHealth, 0, 1, 0)
            end
            wait(0.1)
        end
    end)
end

local function updateESP()
    if not ESPEnabled then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local role = getRole(player)
            local shouldESP = false
            
            if role == "Murderer" and ESPMurderer then shouldESP = true end
            if role == "Innocent" and ESPInnocent then shouldESP = true end
            if role == "Sheriff" and ESPSheriff then shouldESP = true end
            
            if shouldESP then
                if not ESPFolder:FindFirstChild(player.Name .. "_ESP") then
                    createESP(player, role)
                end
            else
                local existing = ESPFolder:FindFirstChild(player.Name .. "_ESP")
                if existing then existing:Destroy() end
            end
        end
    end
    
